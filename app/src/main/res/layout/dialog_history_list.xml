<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.Material3.HeadlineSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/browsing_history" />

        <ImageButton
            android:id="@+id/closeHistoryButton"
            android:layout_width="@dimen/browser_touch_target"
            android:layout_height="@dimen/browser_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_history"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/historySearchLayout"
        style="@style/Widget.SlimBrowser.GlassTextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/search_history"
        app:startIconContentDescription="@string/search_history"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/historySearchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="@dimen/browser_touch_target" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:contentDescription="@string/history_list_description"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/historyEmptyState"
            style="@style/TextAppearance.Material3.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/history_empty" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clearHistoryButton"
        style="@style/Widget.SlimBrowser.GlassButton.Subtle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/clear_all_history"
        android:minHeight="@dimen/browser_touch_target"
        android:text="@string/clear_all_history"
        android:textColor="?attr/colorError" />
</LinearLayout>
