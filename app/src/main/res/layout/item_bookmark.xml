<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bookmarkTitle"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/pinnedBadge"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/colorPrimaryContainer"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/pinned_to_home_badge"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/bookmarkUrl"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/editBookmarkButton"
                android:layout_width="@dimen/browser_touch_target"
                android:layout_height="@dimen/browser_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_edit"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/pinBookmarkButton"
                android:layout_width="@dimen/browser_touch_target"
                android:layout_height="@dimen/browser_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_pin"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/moveBookmarkUpButton"
                android:layout_width="@dimen/browser_touch_target"
                android:layout_height="@dimen/browser_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_up"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/moveBookmarkDownButton"
                android:layout_width="@dimen/browser_touch_target"
                android:layout_height="@dimen/browser_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_down"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/deleteBookmarkButton"
                android:layout_width="@dimen/browser_touch_target"
                android:layout_height="@dimen/browser_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_delete"
                app:tint="?attr/colorError" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
