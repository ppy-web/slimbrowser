<?xml version="1.0" encoding="utf-8"?>
<com.example.slimbrowser.ui.browser.LiquidGlassBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        style="@style/TextAppearance.Material3.HeadlineSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/urlInputLayout"
                style="@style/Widget.SlimBrowser.GlassTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/home_url"
                app:helperText="@string/https_only_hint"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/urlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/emptyHomeHint"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/empty_home_hint" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/fullscreenSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/fullscreen" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/darkThemeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dark_theme" />

            <TextView
                android:id="@+id/backgroundStatus"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/default_background" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chooseBackgroundButton"
                style="@style/Widget.SlimBrowser.GlassButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/choose_background" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearBackgroundButton"
                style="@style/Widget.SlimBrowser.GlassButton.Subtle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/clear_background" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addFavoriteButton"
                style="@style/Widget.SlimBrowser.GlassButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/favorite_current_page" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openFavoritesButton"
                style="@style/Widget.SlimBrowser.GlassButton.Subtle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_favorites" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearSiteDataButton"
                style="@style/Widget.SlimBrowser.GlassButton.Subtle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/clear_site_data"
                android:text="@string/clear_site_data" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            style="@style/Widget.SlimBrowser.GlassButton.Subtle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/Widget.SlimBrowser.GlassButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/save" />
    </LinearLayout>

</com.example.slimbrowser.ui.browser.LiquidGlassBar>
