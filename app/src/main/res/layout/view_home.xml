<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeScene"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="56dp"
            android:paddingEnd="24dp"
            android:paddingBottom="120dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_silmbo" />

            <TextView
                style="@style/TextAppearance.Material3.HeadlineMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/app_name" />

            <TextView
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/home_intro" />

            <com.example.slimbrowser.ui.browser.LiquidGlassBar
                android:id="@+id/homeSearchSurface"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/homeInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="none"
                    android:background="@null"
                    android:hint="@string/address_or_search_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/homeGoButton"
                    android:layout_width="@dimen/browser_touch_target"
                    android:layout_height="@dimen/browser_touch_target"
                    android:background="@drawable/glass_icon_ripple"
                    android:contentDescription="@string/open"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_search"
                    app:tint="?attr/colorOnSurface" />
            </com.example.slimbrowser.ui.browser.LiquidGlassBar>

            <TextView
                android:id="@+id/homeInputError"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:accessibilityLiveRegion="assertive"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                style="@style/Widget.SlimBrowser.GlassButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:contentDescription="@string/continue_browsing"
                android:text="@string/continue_browsing"
                android:visibility="gone"
                app:icon="@drawable/ic_forward" />

            <TextView
                android:id="@+id/pinnedTitle"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/pinned_sites"
                android:visibility="gone" />

            <GridLayout
                android:id="@+id/pinnedGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alignmentMode="alignMargins"
                android:columnCount="4"
                android:useDefaultMargins="false" />

            <TextView
                android:id="@+id/recentTitle"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/recent_visits"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/recentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/homeEmptyState"
                style="@style/TextAppearance.Material3.BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/home_empty_state" />
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/homeSettingsButton"
        android:layout_width="@dimen/browser_touch_target"
        android:layout_height="@dimen/browser_touch_target"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/glass_icon_ripple"
        android:contentDescription="@string/open_settings"
        android:padding="12dp"
        app:srcCompat="@drawable/ic_settings"
        app:tint="?attr/colorOnSurface" />
</FrameLayout>
