<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browserScene"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/refresh_page">

        <FrameLayout
            android:id="@+id/webViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/web_content" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/pageProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <TextView
        android:id="@+id/loadingStatus"
        style="@style/TextAppearance.Material3.LabelLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:accessibilityLiveRegion="polite"
        android:background="?attr/colorSurface"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/loading"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:padding="28dp"
        android:visibility="gone">

        <com.example.slimbrowser.ui.browser.LiquidGlassBar
            android:id="@+id/errorCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/errorTitle"
                style="@style/TextAppearance.Material3.TitleLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/error_title" />

            <TextView
                android:id="@+id/errorMessage"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="assertive"
                android:text="@string/error_message_default" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/errorSecondaryButton"
                    style="@style/Widget.SlimBrowser.GlassButton.Subtle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/go_back" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/errorPrimaryButton"
                    style="@style/Widget.SlimBrowser.GlassButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/retry" />
            </LinearLayout>
        </com.example.slimbrowser.ui.browser.LiquidGlassBar>
    </FrameLayout>

    <com.example.slimbrowser.ui.browser.LiquidGlassBar
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="@dimen/browser_touch_target"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/find_in_page"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true" />

        <TextView
            android:id="@+id/findResult"
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:gravity="center"
            android:text="@string/find_no_result" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/findPreviousButton"
            android:layout_width="@dimen/browser_touch_target"
            android:layout_height="@dimen/browser_touch_target"
            android:background="@drawable/glass_icon_ripple"
            android:contentDescription="@string/find_previous"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_arrow_up"
            app:tint="?attr/colorOnSurface" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/findNextButton"
            android:layout_width="@dimen/browser_touch_target"
            android:layout_height="@dimen/browser_touch_target"
            android:background="@drawable/glass_icon_ripple"
            android:contentDescription="@string/find_next"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_arrow_down"
            app:tint="?attr/colorOnSurface" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/findCloseButton"
            android:layout_width="@dimen/browser_touch_target"
            android:layout_height="@dimen/browser_touch_target"
            android:background="@drawable/glass_icon_ripple"
            android:contentDescription="@string/close"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_close"
            app:tint="?attr/colorOnSurface" />
    </com.example.slimbrowser.ui.browser.LiquidGlassBar>

    <View
        android:id="@+id/toolbarRevealHandle"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_gravity="bottom"
        android:background="@drawable/toolbar_reveal_handle"
        android:clickable="true"
        android:contentDescription="@string/show_browser_toolbar"
        android:focusable="true"
        android:importantForAccessibility="yes"
        android:visibility="gone" />

    <com.example.slimbrowser.ui.browser.LiquidGlassBar
        android:id="@+id/browserToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/toolbarCompactRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/backButton"
                android:layout_width="@dimen/browser_touch_target"
                android:layout_height="@dimen/browser_touch_target"
                android:background="@drawable/glass_icon_ripple"
                android:contentDescription="@string/go_back"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_back"
                app:tint="?attr/colorOnSurface" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/forwardButton"
                android:layout_width="@dimen/browser_touch_target"
                android:layout_height="@dimen/browser_touch_target"
                android:background="@drawable/glass_icon_ripple"
                android:contentDescription="@string/go_forward"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_forward"
                app:tint="?attr/colorOnSurface" />

            <ImageView
                android:id="@+id/securityIcon"
                android:layout_width="32dp"
                android:layout_height="@dimen/browser_touch_target"
                android:contentDescription="@string/https_secure"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                app:srcCompat="@drawable/ic_lock"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/addressTitle"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="0dp"
                android:layout_height="@dimen/browser_touch_target"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/address_bar_empty"
                android:textIsSelectable="false" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/reloadButton"
                android:layout_width="@dimen/browser_touch_target"
                android:layout_height="@dimen/browser_touch_target"
                android:background="@drawable/glass_icon_ripple"
                android:contentDescription="@string/refresh_page"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_refresh"
                app:tint="?attr/colorOnSurface" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/moreButton"
                android:layout_width="@dimen/browser_touch_target"
                android:layout_height="@dimen/browser_touch_target"
                android:background="@drawable/glass_icon_ripple"
                android:contentDescription="@string/more_actions"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_more"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolbarEditRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/addressInput"
                android:layout_width="0dp"
                android:layout_height="@dimen/browser_touch_target"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/address_or_search_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:selectAllOnFocus="true"
                android:singleLine="true" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/addressGoButton"
                android:layout_width="@dimen/browser_touch_target"
                android:layout_height="@dimen/browser_touch_target"
                android:background="@drawable/glass_icon_ripple"
                android:contentDescription="@string/open"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_forward"
                app:tint="?attr/colorOnSurface" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/addressCancelButton"
                android:layout_width="@dimen/browser_touch_target"
                android:layout_height="@dimen/browser_touch_target"
                android:background="@drawable/glass_icon_ripple"
                android:contentDescription="@string/cancel"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_close"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>
    </com.example.slimbrowser.ui.browser.LiquidGlassBar>
</FrameLayout>
