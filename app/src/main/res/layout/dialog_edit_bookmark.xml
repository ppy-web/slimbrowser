<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/bookmarkEditorTitle"
        style="@style/TextAppearance.Material3.HeadlineSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/edit_bookmark" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/bookmarkTitleLayout"
        style="@style/Widget.SlimBrowser.GlassTextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/bookmark_title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/bookmarkTitleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:minHeight="@dimen/browser_touch_target" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/bookmarkUrlLayout"
        style="@style/Widget.SlimBrowser.GlassTextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/bookmark_url">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/bookmarkUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1"
            android:minHeight="@dimen/browser_touch_target" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/pinBookmarkSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="@dimen/browser_touch_target"
        android:text="@string/pin_to_home" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelBookmarkEditButton"
            style="@style/Widget.SlimBrowser.GlassButton.Subtle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/browser_touch_target"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveBookmarkEditButton"
            style="@style/Widget.SlimBrowser.GlassButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="@dimen/browser_touch_target"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
