<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SlimBrowser" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/seed</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>

    <style name="Widget.SlimBrowser.GlassTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/glass_control_fill_subtle</item>
        <item name="boxCornerRadiusTopStart">20dp</item>
        <item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item>
        <item name="boxCornerRadiusBottomEnd">20dp</item>
        <item name="boxStrokeColor">@color/glass_control_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="Widget.SlimBrowser.GlassButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="backgroundTint">@color/glass_control_fill</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/glass_control_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.SlimBrowser.GlassButton.Subtle" parent="Widget.SlimBrowser.GlassButton">
        <item name="backgroundTint">@color/glass_control_fill_subtle</item>
        <item name="strokeWidth">0dp</item>
    </style>
</resources>
